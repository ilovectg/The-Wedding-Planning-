# Backend Configuration
# Environment Variables for Wedding Planning Services

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=wedding_planning
DB_PORT=3306
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Email Configuration (For Email Verification & Notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# File Upload
MAX_FILE_SIZE=5000000
UPLOAD_FOLDER=./uploads

# Payment Gateway Keys
BKASH_APP_KEY=your_bkash_key
BKASH_APP_SECRET=your_bkash_secret
NAGAD_MERCHANT_ID=your_nagad_merchant_id

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Admin Settings
ADMIN_EMAIL=admin@weddingplanning.com
ADMIN_PASSWORD=admin123

# Features
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PAYMENT=true
ENABLE_NOTIFICATIONS=true
